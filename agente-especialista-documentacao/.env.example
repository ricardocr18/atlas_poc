# ============================================================
# ATLAS DOCUMENTACAO AGENT — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores
# NUNCA versione o arquivo .env no git
# ============================================================

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=atlas_documentacao_agente

# --- Aplicação ---
APP_ENV=development
APP_LOG_LEVEL=INFO

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-sua-chave-aqui
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3

# --- Modo de entrada ---
# file       → lê mock_input/component_event.json
# mock_kafka → simula Kafka usando o JSON local
# kafka      → consumer Kafka real (broker da Sicredi)
INPUT_MODE=file

# --- Kafka ---
# Preencher quando tiver acesso ao broker da Sicredi
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=atlas-processamento-assincrono-dados
KAFKA_GROUP_ID=atlas-documentacao-agent-group
KAFKA_AUTO_OFFSET_RESET=earliest

# --- Kafka SSL/SASL (preencher quando necessário) ---
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CA_LOCATION=